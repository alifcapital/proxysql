+/*
+  ProxySQL relay login (see PROXYSQL_RELAY in mysql.h).
+
+  We want the client of ProxySQL to answer the scramble of the server. So we
+  publish the scramble, suspend the connect call until the caller supplies the
+  answer, and send that answer as the authentication response. A connect call
+  that is not suspended cannot park, so we refuse to relay then.
+*/
+static PROXYSQL_RELAY *relay_of(MYSQL *mysql)
+{
+  return mysql->options.extension ? mysql->options.extension->proxysql_relay : NULL;
+}
+
+/*
+  Tells if the server sent data, or closed the connection, while we wait for
+  the caller. The server sends nothing before it gets the response.
+*/
+static my_bool relay_server_gone(MYSQL *mysql)
+{
+  char c;
+  my_socket sock;
+  ssize_t res;
+
+  if (!mysql->net.pvio || ma_pvio_get_handle(mysql->net.pvio, &sock))
+    return 1;
+  res= recv(sock, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (res >= 0)
+    return 1;
+  return errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR;
+}
+
+static int relay_park(MYSQL *mysql, PROXYSQL_RELAY *relay)
+{
+  struct mysql_async_context *b= mysql->options.extension->async_context;
+
+  if (!b || !b->active)
+  {
+    my_set_error(mysql, CR_UNKNOWN_ERROR, SQLSTATE_UNKNOWN,
+                 "ProxySQL relay login needs a non blocking connect");
+    return CR_ERROR;
+  }
+  relay->state= PROXYSQL_RELAY_SCRAMBLE_READY;
+  while (relay->state != PROXYSQL_RELAY_RESPONSE_SET)
+  {
+    b->events_to_wait_for= MYSQL_WAIT_READ;
+    if (b->suspend_resume_hook)
+      (*b->suspend_resume_hook)(TRUE, b->suspend_resume_hook_user_data);
+    my_context_yield(&b->async_context);
+    if (b->suspend_resume_hook)
+      (*b->suspend_resume_hook)(FALSE, b->suspend_resume_hook_user_data);
+    /*
+      The caller may continue us without a reason: it passes the events of the
+      socket to the call of every owner of the connection. So we look at the
+      socket ourselves, and wait again if the server did nothing.
+    */
+    if (relay->state != PROXYSQL_RELAY_RESPONSE_SET && relay_server_gone(mysql))
+    {
+      my_set_error(mysql, CR_SERVER_LOST, SQLSTATE_UNKNOWN,
+                          ER(CR_SERVER_LOST_EXTENDED),
+                          "waiting for the authentication response of the client",
+                          errno);
+      return CR_ERROR;
+    }
+  }
+  return CR_OK;
+}
 
