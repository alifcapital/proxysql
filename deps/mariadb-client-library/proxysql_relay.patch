+/*
+  ProxySQL relay login.
+
+  We want the client of ProxySQL to answer the scramble of the server, so that
+  the server authenticates the client and ProxySQL needs no password. The
+  caller sets this structure with MARIADB_OPT_PROXYSQL_RELAY before a non
+  blocking mysql_real_connect_start(). The mysql_native_password plugin then
+  reads the scramble of the server, publishes it in 'scramble', sets 'state' to
+  PROXYSQL_RELAY_SCRAMBLE_READY and suspends the connect call, waiting for
+  READ events. The caller fills 'user', 'db', 'charset', 'client_flag',
+  'response' and 'response_len', sets 'state' to PROXYSQL_RELAY_RESPONSE_SET
+  and continues the connect call. If the call continues while 'state' is not
+  PROXYSQL_RELAY_RESPONSE_SET, the server closed the connection or sent
+  something unexpected, and the connect call fails.
+*/
+#define PROXYSQL_RELAY_IDLE 0
+#define PROXYSQL_RELAY_SCRAMBLE_READY 1
+#define PROXYSQL_RELAY_RESPONSE_SET 2
+#define PROXYSQL_RELAY_DONE 3
 
+typedef struct st_proxysql_relay {
+  int state;
+  unsigned char scramble[21];       /* out: scramble of the server, 20 bytes and 0 */
+  const char *user;                 /* in: user name of the client */
+  const char *db;                   /* in: default database, NULL for none */
+  const void *charset;              /* in: MARIADB_CHARSET_INFO of the client, or NULL */
+  unsigned long client_flag;        /* in: client flags added to the connection */
+  unsigned char response[20];       /* in: authentication response of the client */
+  unsigned int response_len;        /* in: 0 (no password) or 20 */
+} PROXYSQL_RELAY;
 
+
 #ifdef	__cplusplus
 }
 #endif
